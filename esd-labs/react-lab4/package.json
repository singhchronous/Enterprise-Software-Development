{
  "name": "esd-react-lab4",
  "version": "1.0.0",
  "private": true,
  "description": "ESD 2026 — React Lab 4: integration. A hardened client (network errors, 401 → session expired), signup with fieldErrors, 409 states, and your own Spring Boot backend with CORS. Pre-lab checked by Vitest; an in-lab AI task checked by npm run inlab.",
  "type": "module",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:stretch": "vitest run --mode stretch",
    "test:all": "vitest run --mode all",
    "test:watch": "vitest",
    "inlab": "vitest run --mode inlab",
    "mock": "node mock/server.js",
    "carry": "node tools/carry.js"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
